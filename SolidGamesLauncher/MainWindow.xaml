<Window x:Class="Arma3Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SolidGames Launcher" Height="680" Width="1060" MinHeight="540" MinWidth="850"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#0D0F0E" Foreground="#E0E0E0" FontFamily="Roboto, Segoe UI"
        SizeChanged="Window_SizeChanged" Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Полосы строк во вкладках, которые темнеют при наведении мыши -->
        <Style x:Key="ArmaStripeRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#28181D1A"/>
            <Setter Property="BorderBrush" Value="#2E3632"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="22,13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B8060807"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Заголовки разделов (ИГРА / ЛАУНЧЕР) во вкладке ПАРАМЕТРЫ -->
        <Style x:Key="ArmaSectionHeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#88101412"/>
            <Setter Property="BorderBrush" Value="#4E9A51"/>
            <Setter Property="BorderThickness" Value="4,0,0,1"/>
            <Setter Property="Padding" Value="18,9"/>
        </Style>

        <!-- Квадратные переключатели для выбора только одного сервера -->
        <Style x:Key="ArmaSquareRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="checkBoxBorder" Width="18" Height="18" 
                                    Background="#101412" BorderBrush="#8A948E" BorderThickness="1" 
                                    VerticalAlignment="Center">
                                <Border x:Name="checkMark" Width="10" Height="10" Background="#4E9A51" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#4E9A51"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Квадратные чекбоксы для вкладки ПАРАМЕТРЫ -->
        <Style x:Key="ArmaSquareCheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="checkBoxBorder" Width="18" Height="18" 
                                    Background="#101412" BorderBrush="#8A948E" BorderThickness="1" 
                                    VerticalAlignment="Center">
                                <Border x:Name="checkMark" Width="10" Height="10" Background="#4E9A51" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#4E9A51"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Левое меню с подсветкой выбранной вкладки -->
        <Style x:Key="ArmaSidebarMenuStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D8DDD9"/>
            <Setter Property="FontSize" Value="16.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                            <Border x:Name="LeftBar" Width="8" HorizontalAlignment="Left" Background="Transparent"/>
                            <ContentPresenter VerticalAlignment="Center" Margin="26,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootGrid" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootGrid" Property="Background" Value="#384E9A51"/>
                                <Setter Property="Foreground" Value="#68C76B"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="LeftBar" Property="Background" Value="#4E9A51"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Черная кнопка "ЗАПУСК БЕЗ ПРИСОЕДИНЕНИЯ К СЕРВЕРУ" -->
        <Style x:Key="ArmaBlackLaunchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#070908"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#28302C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="8,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#181F1C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4E9A51"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4E9A51"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#252927"/>
                                <Setter Property="Foreground" Value="#68706C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Главная кнопка ЗАПУСК (СЕРВЕР 1 / СЕРВЕР 2) -->
        <Style x:Key="ArmaAccentLaunchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#488B49"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#56A357"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#39703A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#252927"/>
                                <Setter Property="Foreground" Value="#68706C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки действий внутри вкладок -->
        <Style x:Key="ArmaActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#141817"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3E4642"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#242B28"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4E9A51"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4E9A51"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#0C0E0D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#222624"/>
                                <Setter Property="Foreground" Value="#505653"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки управления окном -->
        <Style x:Key="WindowControlBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D0D5D2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ВНЕШНЯЯ РАМКА ОКНА -->
    <Border BorderBrush="#262B28" BorderThickness="1">
        <Grid>
            <Grid.Resources>
                <ScaleTransform x:Key="AdaptiveScale" ScaleX="1" ScaleY="1"/>
            </Grid.Resources>

            <!-- ФОНОВАЯ КАРТИНКА (bg1920w.jpg) -->
            <Image x:Name="BgImage" Stretch="UniformToFill" Opacity="1.0"/>
            <Border Background="#1A080A09"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= ЛЕВАЯ ПАНЕЛЬ ================= -->
                <Border Grid.Column="0" Width="240" LayoutTransform="{DynamicResource AdaptiveScale}" Background="#45090C0B" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="125"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Кликабельный логотип SolidGames слева-сверху -->
                        <Button Grid.Row="0" Click="LogoButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" ToolTip="Перейти на https://sg.zone/" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="15,10,15,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Image x:Name="LogoImage" Height="80" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="LogoFallbackText" Text="SOLID GAMES" FontSize="24" FontWeight="Black" Foreground="#D0D5D2" Visibility="Collapsed"/>
                            </Grid>
                        </Button>

                        <!-- Вкладки слева -->
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <RadioButton x:Name="NavSgZoneBtn" Content="SG.ZONE" Style="{StaticResource ArmaSidebarMenuStyle}" Checked="NavTab_Checked"/>
                            <RadioButton x:Name="NavServersBtn" Content="СЕРВЕРЫ" Style="{StaticResource ArmaSidebarMenuStyle}" IsChecked="True" Checked="NavTab_Checked"/>
                            <RadioButton x:Name="NavModsBtn" Content="МОДЫ" Style="{StaticResource ArmaSidebarMenuStyle}" Checked="NavTab_Checked"/>
                            <RadioButton x:Name="NavTsBtn" Content="TEAMSPEAK 3" Style="{StaticResource ArmaSidebarMenuStyle}" Checked="NavTab_Checked"/>
                            <RadioButton x:Name="NavParamsBtn" Content="ПАРАМЕТРЫ" Style="{StaticResource ArmaSidebarMenuStyle}" Checked="NavTab_Checked"/>
                            <RadioButton x:Name="NavStatsBtn" Content="СТАТИСТИКА" Style="{StaticResource ArmaSidebarMenuStyle}" Visibility="Collapsed" Checked="NavTab_Checked"/>
                        </StackPanel>

                        <!-- Нижние кнопки запуска -->

                        <StackPanel Grid.Row="2" Margin="16,0,16,18">
                            <Button x:Name="LaunchNoServerBtn" Height="50" Style="{StaticResource ArmaBlackLaunchButtonStyle}" Margin="0,0,0,12" Click="LaunchGameOnly_Click">
                                <TextBlock Text="ЗАПУСК БЕЗ ПРИСОЕДИНЕНИЯ К СЕРВЕРУ" TextWrapping="Wrap" TextAlignment="Center" LineHeight="16"/>
                            </Button>

                            <Button x:Name="LaunchServerBtn" Height="56" Style="{StaticResource ArmaAccentLaunchButtonStyle}" Click="ConnectAndPlay_Click">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="ЗАПУСК" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                    <TextBlock x:Name="LaunchServerBtnText" Text="СЕРВЕР 1" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= ПРАВАЯ ЧАСТЬ ================= -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Верхняя полоса окна -->
                    <Grid Grid.Row="0" Height="42" LayoutTransform="{DynamicResource AdaptiveScale}" Background="Transparent" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                        <TextBlock Text="SOLIDGAMES LAUNCHER" Foreground="#88928D" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
                            <Button Content="—" Style="{StaticResource WindowControlBtnStyle}" Click="MinimizeWindow_Click" ToolTip="Свернуть"/>
                            <Button Content="▢" Style="{StaticResource WindowControlBtnStyle}" Click="MaximizeRestoreWindow_Click" ToolTip="Развернуть / Восстановить"/>
                            <Button Content="✕" Style="{StaticResource WindowControlBtnStyle}" Click="CloseWindow_Click" ToolTip="Закрыть"/>
                        </StackPanel>
                    </Grid>

                    <!-- Верхние плашки заголовка активной вкладки -->
                    <Grid Grid.Row="1" Height="42" LayoutTransform="{DynamicResource AdaptiveScale}" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#CFD4D1" Height="38" Padding="26,0" VerticalAlignment="Bottom">
                                <TextBlock x:Name="ActiveSectionHeaderText" Text="СЕРВЕРЫ И ПРОФИЛЬ" Foreground="#111312" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="#CC090B0A" Height="38" Padding="20,0" VerticalAlignment="Bottom">
                                <TextBlock x:Name="ArmaPathStatusText" Text="ПАПКА ARMA 3 ПРОВЕРЯЕТСЯ..." Foreground="#D0D5D2" FontSize="13.5" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ОСНОВНАЯ ПОЛУПРОЗРАЧНАЯ РАБОЧАЯ ОБЛАСТЬ -->
                    <Border Grid.Row="2" Background="#550B0D0C" BorderBrush="#2A302D" BorderThickness="0,1,0,0">
                        <Grid>

                            <!-- ==================== ВКЛАДКА: СЕРВЕРЫ ==================== -->
                            <StackPanel x:Name="PageServers" LayoutTransform="{DynamicResource AdaptiveScale}">
                                <Border Style="{StaticResource ArmaStripeRowStyle}">
                                    <Grid>
                                        <TextBlock Text="⚡ Выберите сервер и профиль для запуска" Foreground="#E0E4E1" FontSize="15" VerticalAlignment="Center"/>
                                        <Button Content="↻ Обновить онлайн" HorizontalAlignment="Right" Style="{StaticResource ArmaActionBtnStyle}" Click="RefreshServerStatus_Click"/>
                                    </Grid>
                                </Border>
                                <!-- Большая надпись, если не выбрана папка с модами Resilio -->
                                <Border x:Name="ResilioWarningBanner" Background="#443A1010" BorderBrush="#FF4444" BorderThickness="1" Margin="22,18,22,0" Padding="20,16">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="ВЫБЕРИТЕ ПАПКУ С МОДАМИ RESILIO ДЛЯ ЗАПУСКА ИГРЫ" 
                   Foreground="#FF5555" FontSize="18" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Text="Перейдите во вкладку «МОДЫ» и укажите папку, куда скачались моды" 
                   Foreground="#D8DDD9" FontSize="13.5" TextAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ArmaStripeRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="340"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Профиль Arma 3:" Foreground="#FFFFFF" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,25,0"/>
                                        <ComboBox x:Name="ProfileComboBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center" IsEditable="True" FontSize="15" SelectionChanged="UserSettings_Changed"/>
                                        <Button Grid.Column="2" Content="↻" Width="34" Height="32" Margin="8,0,0,0" Style="{StaticResource ArmaActionBtnStyle}" Click="RefreshProfiles_Click" ToolTip="Обновить профили"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource ArmaStripeRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="340"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Никнейм для TeamSpeak 3:" Foreground="#FFFFFF" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,25,0"/>
                                        <TextBox x:Name="TsNicknameTextBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Padding="8,0" Background="#080A09" Foreground="White" BorderBrush="#454D49" FontSize="15" Text="[SG]Игрок" TextChanged="UserSettings_Changed"/>
                                    </Grid>
                                </Border>
                                

                                <!-- Сервер 1 с выбором адреса TS3 -->
                                <Border Style="{StaticResource ArmaStripeRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Сервер 1:" Foreground="#FFFFFF" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,25,0"/>
                                        <RadioButton x:Name="Server1Radio" GroupName="SolidServersGroup" Grid.Column="1" Content="s1.sg.zone:2302   |" Style="{StaticResource ArmaSquareRadioStyle}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Checked="ServerSelection_Changed"/>

                                        <!-- Выпадающий список TS3 для Сервера 1 со сноской сверху -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Выбор сервера TS3" Foreground="#9AA49E" FontSize="11" Margin="2,0,0,3"/>
                                            <ComboBox x:Name="Server1TsComboBox" Height="28" FontSize="13.5" SelectedIndex="0" SelectionChanged="UserSettings_Changed">
                                                <ComboBoxItem Content="TS3: t1.sg.zone" Tag="t1.sg.zone:9987"/>
                                                <ComboBoxItem Content="TS3: 87.58.213.152" Tag="87.58.213.152:9987"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <Border Grid.Column="4" Background="#121715" BorderBrush="#36403B" BorderThickness="1" Padding="14,5" VerticalAlignment="Center">
                                            <TextBlock x:Name="Server1PlayersText" Text="Игроков: загрузка..." Foreground="#68C76B" FontWeight="SemiBold" FontSize="14"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Сервер 2 с выбором адреса TS3 -->
                                <Border Style="{StaticResource ArmaStripeRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Сервер 2:" Foreground="#FFFFFF" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,25,0"/>
                                        <RadioButton x:Name="Server2Radio" GroupName="SolidServersGroup" Grid.Column="1" Content="s2.sg.zone:2302   |" Style="{StaticResource ArmaSquareRadioStyle}" VerticalAlignment="Center" Margin="0,0,14,0" Checked="ServerSelection_Changed"/>

                                        <!-- Выпадающий список TS3 для Сервера 2 со сноской сверху -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Выбор сервера TS3" Foreground="#9AA49E" FontSize="11" Margin="2,0,0,3"/>
                                            <ComboBox x:Name="Server2TsComboBox" Height="28" FontSize="13.5" SelectedIndex="0" SelectionChanged="UserSettings_Changed">
                                                <ComboBoxItem Content="TS3: t2.sg.zone" Tag="t2.sg.zone:9987"/>
                                                <ComboBoxItem Content="TS3: 87.58.213.152:9988" Tag="87.58.213.152:9988"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <Border Grid.Column="4" Background="#121715" BorderBrush="#36403B" BorderThickness="1" Padding="14,5" VerticalAlignment="Center">
                                            <TextBlock x:Name="Server2PlayersText" Text="Игроков: загрузка..." Foreground="#68C76B" FontWeight="SemiBold" FontSize="14"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ==================== ВКЛАДКА: МОДЫ ==================== -->
                            <ScrollViewer x:Name="PageMods" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel LayoutTransform="{DynamicResource AdaptiveScale}">
                                    <Border Style="{StaticResource ArmaStripeRowStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Статус клиента Resilio Sync:  " Foreground="#E0E4E1" FontSize="15" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ResilioStatusText" Text="Не установлено" Foreground="#FF4444" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ArmaStripeRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="InstallResilioBtn" Grid.Column="0" Content="1. СКАЧАТЬ / УСТАНОВИТЬ RESILIO SYNC" Height="38" Style="{StaticResource ArmaActionBtnStyle}" Click="InstallResilio_Click"/>
                                            <Button x:Name="SyncResilioModsBtn" Grid.Column="2" Content="2. СКАЧАТЬ МОДЫ ЧЕРЕЗ RESILIO" Height="38" Style="{StaticResource ArmaActionBtnStyle}" IsEnabled="False" Click="DownloadResilioMods_Click"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource ArmaStripeRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                                                <TextBlock x:Name="ResilioModsFolderText" Text="Папка модов Resilio: не выбрана" Foreground="#FFFFFF" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="ResilioModsCheckText" Text="Укажите папку, куда скачались @sg_core, @sg_islands и @sg_mods" Foreground="#FF6B6B" FontSize="13" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="ВЫБРАТЬ ПАПКУ С МОДАМИ (RESILIO)" Height="38" Width="280" Style="{StaticResource ArmaActionBtnStyle}" Click="SelectResilioModsFolder_Click"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource ArmaStripeRowStyle}">
                                        <StackPanel>
                                            <TextBlock Text="ПАМЯТКА ПО НАСТРОЙКЕ РАЗДАЧИ RESILIO SYNC:" Foreground="#68C76B" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,5"/>

                                            <TextBlock Foreground="#E0E0E0" FontSize="13.5" TextWrapping="Wrap" Margin="0,0,0,3">
                                                <Run Text="1." FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <Run Text=" Нажмите кнопку 2 — ключ (BAORERSOCOOW764LYFEVHPMOHUV5FW34M) скопируется в буфер обмена. Добавьте его через «+» → «Ввести ключ или ссылку»."/>
                                            </TextBlock>

                                            <TextBlock Foreground="#E0E0E0" FontSize="13.5">
                                                <Run Text="2." FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <Run Text=" Нажмите ПКМ по раздаче → Настройки:"/>
                                            </TextBlock>
                                            <TextBlock Text="   • Уберите галочку с «Сохранять удаленные файлы в архив»" Foreground="#FF6B6B" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="   • Поставьте галочку «Перезаписывать измененные файлы»" Foreground="#68C76B" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,4"/>

                                            <TextBlock Foreground="#B0B8B4" FontSize="13.5" TextWrapping="Wrap">
                                                <Run Text="3." FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <Run Text=" Состояния: "/>
                                                <Run Text="Синий круг" Foreground="#4DA6FF" FontWeight="Bold"/>
                                                <Run Text="— это скачивание; "/>
                                                <Run Text="Зеленый круг" Foreground="#68C76B" FontWeight="Bold"/>
                                                <Run Text="— моды загружены, идет раздача."/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ArmaStripeRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Коллекция модов проекта в Steam Workshop" Foreground="#FFFFFF" FontSize="14.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="@RHSAFRF, @RHSUSAF, @RHSGREF, @RHSSAF, @CUP Terrains - Core" Foreground="#9AA49E" FontSize="13"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="ПОДПИСАТЬСЯ В STEAM WORKSHOP" Height="38" Width="280" Style="{StaticResource ArmaActionBtnStyle}" Click="SubscribeSteamWorkshop_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ==================== 2. ВКЛАДКА: TEAMSPEAK 3 ==================== -->
                            <StackPanel x:Name="PageTs" LayoutTransform="{DynamicResource AdaptiveScale}" Visibility="Collapsed">
                                <!-- Статус установки TeamSpeak 3-->
                                <Border Style="{StaticResource ArmaStripeRowStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Статус клиента TeamSpeak 3:  " Foreground="#E0E4E1" FontSize="15" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TsStatusText" Text="Не установлено" Foreground="#FF4444" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Кнопки скачивания клиента-->
                                <Border Style="{StaticResource ArmaStripeRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Клиент TeamSpeak 3:" Foreground="#FFFFFF" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0"/>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="СКАЧАТЬ КЛИЕНТ С SG.ZONE" Height="40" Style="{StaticResource ArmaActionBtnStyle}" Click="DownloadTS3FromSgZone_Click"/>
                                            <Button Grid.Column="2" Content="СКАЧАТЬ С ОФИЦИАЛЬНОГО САЙТА" Height="40" Style="{StaticResource ArmaActionBtnStyle}" Click="InstallTS3_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource ArmaStripeRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Плагин рации для TS3:" Foreground="#FFFFFF" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0"/>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="СКАЧАТЬ ПЛАГИН С SG.ZONE" Height="40" Style="{StaticResource ArmaActionBtnStyle}" Click="DownloadTS3PluginFromWeb_Click"/>
                                            <Button Grid.Column="2" Content="ОТКРЫТЬ ПАПКУ С ПЛАГИНОМ" Height="40" Style="{StaticResource ArmaActionBtnStyle}" Click="OpenModsFolderForPlugin_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource ArmaStripeRowStyle}">
                                    <TextBlock Text="Примечание: если не получается скачать плагин с сайта, то его можно найти в скачанной папке модов Resilio по пути: @sg_core\teamspeak\task_force_radio.ts3_plugin. Нажмите «Открыть папку с плагином», чтобы сразу перейти к нему." 
                                               Foreground="#D8DDD9" FontSize="14" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <!-- ==================== 3. ВКЛАДКА: ПАРАМЕТРЫ ==================== -->
                            <ScrollViewer x:Name="PageParams" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel LayoutTransform="{DynamicResource AdaptiveScale}">
                                    <!-- ЗАГОЛОВОК 1: ИГРА -->
                                    <Border Style="{StaticResource ArmaSectionHeaderBorderStyle}">
                                        <TextBlock Text="ИГРА" Foreground="#68C76B" FontSize="15.5" FontWeight="Bold"/>
                                    </Border>

                                    <Border Style="{StaticResource ArmaStripeRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="430"/>
                                                <ColumnDefinition Width="300"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Распределитель памяти (Arma 3\Dll):" Foreground="#FFFFFF" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,25,0" TextWrapping="Wrap"/>
                                            <ComboBox x:Name="MallocComboBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center" FontSize="14" SelectionChanged="UserSettings_Changed"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource ArmaStripeRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="430"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Пропускать логотипы при запуске (-noSplash):" Foreground="#FFFFFF" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,25,0" TextWrapping="Wrap"/>
                                            <CheckBox x:Name="ParamNoSplashCheck" Grid.Column="1" Style="{StaticResource ArmaSquareCheckStyle}" IsChecked="True" VerticalAlignment="Center" Checked="UserSettings_Changed" Unchecked="UserSettings_Changed"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource ArmaStripeRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="430"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Ускорить загрузку главного меню (-world=empty):" Foreground="#FFFFFF" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,25,0" TextWrapping="Wrap"/>
                                            <CheckBox x:Name="ParamEmptyWorldCheck" Grid.Column="1" Style="{StaticResource ArmaSquareCheckStyle}" IsChecked="True" VerticalAlignment="Center" Checked="UserSettings_Changed" Unchecked="UserSettings_Changed"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource ArmaStripeRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="430"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Включить оконный режим (-window):" Foreground="#FFFFFF" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,25,0" TextWrapping="Wrap"/>
                                            <CheckBox x:Name="ParamWindowedCheck" Grid.Column="1" Style="{StaticResource ArmaSquareCheckStyle}" IsChecked="False" VerticalAlignment="Center" Checked="UserSettings_Changed" Unchecked="UserSettings_Changed"/>
                                        </Grid>
                                    </Border>

                                    <!-- ЗАГОЛОВОК 2: ЛАУНЧЕР -->
                                    <Border Style="{StaticResource ArmaSectionHeaderBorderStyle}" Margin="0,8,0,0">
                                        <TextBlock Text="ЛАУНЧЕР" Foreground="#68C76B" FontSize="15.5" FontWeight="Bold"/>
                                    </Border>

                                    <Border Style="{StaticResource ArmaStripeRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="430"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Закрывать лаунчер при запуске игры:" Foreground="#FFFFFF" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,25,0" TextWrapping="Wrap"/>
                                            <CheckBox x:Name="ParamCloseOnLaunchCheck" Grid.Column="1" Style="{StaticResource ArmaSquareCheckStyle}" IsChecked="False" VerticalAlignment="Center" Checked="UserSettings_Changed" Unchecked="UserSettings_Changed"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource ArmaStripeRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="430"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Запоминать положение лаунчера при закрытии:" Foreground="#FFFFFF" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,25,0" TextWrapping="Wrap"/>
                                            <CheckBox x:Name="ParamRememberWindowCheck" Grid.Column="1" Style="{StaticResource ArmaSquareCheckStyle}" IsChecked="False" VerticalAlignment="Center" Checked="UserSettings_Changed" Unchecked="UserSettings_Changed"/>
                                        </Grid>
                                    </Border>

                                    <!-- В самом низу списка: Добавить вкладку Статистика -->
                                    <Border Style="{StaticResource ArmaStripeRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="430"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Добавить вкладку Статистика:" Foreground="#FFFFFF" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,25,0" TextWrapping="Wrap"/>
                                            <CheckBox x:Name="ParamShowStatsTabCheck" Grid.Column="1" Style="{StaticResource ArmaSquareCheckStyle}" IsChecked="False" VerticalAlignment="Center" Checked="StatsOption_Changed" Unchecked="StatsOption_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ==================== ВКЛАДКА: SG.ZONE ==================== -->
                            <Grid x:Name="PageSgZone" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Height="42" LayoutTransform="{DynamicResource AdaptiveScale}" Background="#66141816" BorderBrush="#1C2220" BorderThickness="0,0,0,1" Padding="15,0">
                                    <Grid>
                                        <TextBlock Text="Анонс ближайших игр и расписание миссий на https://sg.zone/" Foreground="#D8DDD9" FontSize="14" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="↻ Обновить" Height="28" Style="{StaticResource ArmaActionBtnStyle}" FontSize="12.5" Margin="0,0,8,0" Click="ReloadSgZone_Click"/>
                                            <Button Content="Открыть в браузере ↗" Height="28" Style="{StaticResource ArmaActionBtnStyle}" FontSize="12.5" Click="LogoButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <wv2:WebView2 x:Name="SgZoneWebView" Grid.Row="1" ZoomFactor="0.67" DefaultBackgroundColor="#0D0F0E"/>
                            </Grid>

                            <!-- ==================== 1. ВКЛАДКА: СТАТИСТИКА ==================== -->
                            <Grid x:Name="PageStats" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Height="42" LayoutTransform="{DynamicResource AdaptiveScale}" Background="#66141816" BorderBrush="#1C2220" BorderThickness="0,0,0,1" Padding="15,0">
                                    <Grid>
                                        <TextBlock Text="Статистика игроков проекта SolidGames (https://solid-stats.web.app/)" Foreground="#D8DDD9" FontSize="14" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="↻ Обновить" Height="28" Style="{StaticResource ArmaActionBtnStyle}" FontSize="12.5" Margin="0,0,8,0" Click="ReloadStats_Click"/>
                                            <Button Content="Открыть в браузере ↗" Height="28" Style="{StaticResource ArmaActionBtnStyle}" FontSize="12.5" Click="OpenStatsInBrowser_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Белый непрозрачный контейнер, чтобы прозрачный фон сайта solid-stats.web.app был чисто белым, как в браузере -->
                                <Border Grid.Row="1" Background="#FFFFFF">
                                    <wv2:WebView2 x:Name="StatsWebView" ZoomFactor="0.80" DefaultBackgroundColor="White"/>
                                </Border>
                            </Grid>

                        </Grid>
                    </Border>

                    <!-- Нижняя правая панель с кликабельной подписью SolidGames Launcher by Natrii -->
                    <Border Grid.Row="3" Background="#66080A09" BorderBrush="#1F2622" BorderThickness="0,1,0,0" Padding="14,5" LayoutTransform="{DynamicResource AdaptiveScale}">
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" BorderThickness="0" Click="AuthorProfileLink_Click" ToolTip="Открыть профиль https://sg.zone/profile/Natrii">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock x:Name="creditText" Text="SolidGames Launcher v1.0 by Natrii" Foreground="#88928D" FontSize="11.5"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="creditText" Property="Foreground" Value="#68C76B"/>
                                            <Setter TargetName="creditText" Property="TextDecorations" Value="Underline"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>